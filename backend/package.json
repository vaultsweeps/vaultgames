{
  "name": "nexus-gaming-backend",
  "version": "1.0.0",
  "description": "NexusGaming Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "npx prisma studio",
    "seed:prod": "node -e \"require('ts-node').register(); require('./prisma/seed.ts')\""
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "express": "^4.21.1",
    "typescript": "^5.6.3",
    "prisma": "^5.21.1",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "axios": "^1.7.7",
    "crypto": "^1.0.1",
    "zod": "^3.23.8",
    "winston": "^3.15.0",
    "compression": "^1.7.4",
    "hpp": "^0.2.3",
    "xss-clean": "^0.1.4",
    "express-mongo-sanitize": "^2.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.16",
    "@types/multer": "^1.4.12",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.7"
  }
}
