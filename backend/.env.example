# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres.dsozhcivspwtzcvovjkl:Dinesh@1122$@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"

# JWT Secrets (use strong random strings in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production_min_32_chars

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Payment Gateway (optional - configure your provider)
# NOWPayments (crypto)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret

# Webhook
WEBHOOK_SECRET=your_webhook_secret_key

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Logging
LOG_LEVEL=info
