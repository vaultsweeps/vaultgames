# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL - Supabase)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# JWT Secrets (use strong random strings in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production_min_32_chars

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Payment Gateway (optional - configure your provider)
# NOWPayments (crypto) — NOWPAYMENTS_IPN_SECRET is required for the
# /api/webhooks/crypto endpoint to accept deposit confirmations; without it,
# that webhook rejects all requests rather than trusting an unverified one.
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret

# Zappay — ZAPPAY_SECRET is required for /api/webhooks/zappay to accept
# deposit confirmations (same fail-closed behavior as NOWPayments above).
ZAPPAY_MERCHANT_ID=your_zappay_merchant_id
ZAPPAY_SECRET=your_zappay_secret
ZAPPAY_BASE_URL=https://sandbox.zappay.com/pay

# Webhook
WEBHOOK_SECRET=your_webhook_secret_key

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Logging
LOG_LEVEL=info

# Telegram Support Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_GROUP_CHAT_ID=your_telegram_group_chat_id
# Optional: comma-separated Telegram user IDs authorized to approve/reject/void
# deposits & withdrawals. If unset, anyone in TELEGRAM_GROUP_CHAT_ID can act —
# set this to restrict money-moving bot actions to specific staff accounts.
TELEGRAM_STAFF_USER_IDS=

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# IMAP (for Chime/PayPal/Zappay deposit auto-verification)
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
# Optional: override the trusted sender domain(s) for auto-approval email
# matching (comma-separated). Defaults to chime.com / paypal.com / zappay.com.
# Only emails whose From address matches get considered — this exists so an
# email merely mentioning "chime" or "paypal" from an arbitrary sender can't
# be used to self-approve a deposit.
CHIME_SENDER_DOMAINS=chime.com
PAYPAL_SENDER_DOMAINS=paypal.com
ZAPPAY_SENDER_DOMAINS=zappay.com

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"