generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                @id @default(cuid())
  username             String                @unique
  email                String                @unique
  password             String
  role                 Role                  @default(user)
  isVerified           Boolean               @default(false)
  isActive             Boolean               @default(true)
  isBanned             Boolean               @default(false)
  verifyToken          String?
  resetToken           String?
  resetExpiry          DateTime?
  lastLogin            DateTime?
  referralCode         String?               @unique
  promoCode            String?               @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  referredById         String?
  isPhoneVerified      Boolean               @default(false)
  // Durable, Redis-independent session revocation. Bumped by logout, password reset/change and admin
  // ban/suspend; a JWT's embedded tokenVersion must match this or it is rejected, even if Redis (which
  // backs the faster `revoked_before` check) is down, unreachable, or was never configured.
  tokenVersion         Int                   @default(0)
  activityLogs         ActivityLog[]
  bonusClaims          BonusClaim[]
  conversations        Conversation[]
  couponUsages         CouponUsage[]
  deposits             Deposit[]
  gameDownloads        GameDownload[]
  notifications        Notification[]
  providerTransactions ProviderTransaction[]
  providerUsers        ProviderUser[]
  tickets              SupportTicket[]
  ticketReplies        TicketReply[]
  referredBy           User?                 @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]                @relation("Referrals")
  profile              UserProfile?
  withdrawals          Withdrawal[]
  referralRewardsGiven    ReferralReward[]    @relation("ReferralRewardsGiven")
  referralRewardsReceived ReferralReward[]    @relation("ReferralRewardsReceived")
  wheelSpins              WheelSpin[]
  depositBonuses          DepositBonus[]
  userBonuses             UserBonus[]
  bonusTransactions       BonusTransaction[]
  bonusConversions        BonusConversion[]
  sundayFreeplayClaims    SundayFreeplayClaim[]
  walletTransactions      WalletTransaction[]

  @@index([email])
  @@index([username])
  @@index([referralCode])
}

// One row per referee who has ever triggered a referral reward for their referrer. `refereeId` is unique
// (not a composite with referrerId): each referee has exactly one referrer (User.referredById), so "one
// reward per referee, ever" is exactly what a unique referee id expresses — while placing no limit at all on
// how many different referees one referrer can earn from. This replaces the old design of writing a
// BonusClaim keyed on (referrer, the single shared 'referral' Bonus definition row), which could only ever
// hold one row per referrer in total and made every referral after the first silently fail.
model ReferralReward {
  id               String    @id @default(cuid())
  referrerId       String
  refereeId        String    @unique
  amount           Float
  // 'paid' counts toward the referrer's wallet balance immediately. 'flagged' is held for manual admin
  // review (see AbuseFlag reasoning in ReferralService) and does NOT count until approved. 'rejected' never
  // counts. Nothing is ever silently dropped — every reward decision is a row here.
  status           String    @default("paid")
  triggerSource    String // 'first_deposit' | 'first_recharge' — which qualifying event created this row
  triggerDepositId String?
  flagReason       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  referrer         User      @relation("ReferralRewardsGiven", fields: [referrerId], references: [id])
  referee          User      @relation("ReferralRewardsReceived", fields: [refereeId], references: [id])

  @@index([referrerId])
  @@index([status])
}

// One row per wheel-spin attempt (win or "Try Again" alike), replacing the old design of writing a
// BonusClaim keyed on (user, the specific prize's Bonus row): winning the SAME prize (very commonly "Try
// Again") a second time hit that unique constraint and crashed the request. A plain history table has no
// such ceiling, and it is also the ledger the 48h cooldown and win-pattern counter both read from.
model WheelSpin {
  id        String   @id @default(cuid())
  userId    String
  bonusId   String // which prize (Bonus catalog row) was awarded, Try Again included
  amount    Float    @default(0)
  isWin     Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  bonus     Bonus    @relation(fields: [bonusId], references: [id])

  @@index([userId, createdAt])
}

model UserProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  fullName         String?
  phone            String?
  country          String?
  avatar           String?
  telegramUsername String?
  telegramId       String?
  telegramPhone    String?
  signupPhone      String? // self-reported at sign-up, NOT verified — the verified number is `phone` (set only by OTP)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deposit {
  id                String              @id @default(cuid())
  userId            String
  amount            Float
  currency          String              @default("USD")
  paymentMethodId   String?
  status            DepositStatus       @default(pending)
  transactionId     String?
  paymentReference  String?             @unique
  proofImage        String?
  notes             String?
  webhookData       Json?
  approvedBy        String?
  approvedAt        DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?
  telegramMessageId String?
  telegramChatId    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  paymentMethod     PaymentMethod?      @relation(fields: [paymentMethodId], references: [id])
  user              User                @relation(fields: [userId], references: [id])
  transaction       DepositTransaction?
  depositBonus      DepositBonus?

  @@index([status])
  @@index([userId, status])
}

// A promotional bonus tied to one specific deposit (e.g. the 20% crypto-deposit bonus), kept OUT of
// Deposit.amount so the deposit always represents the real confirmed amount only. `depositId` is unique:
// that is what makes granting it atomic/idempotent — a repeated provider callback for the same deposit
// hits this constraint and is a safe no-op, exactly like ReferralReward.refereeId is for referral rewards.
// Never summed into totalDeposited/withdrawableBalance — see WalletService.
model DepositBonus {
  id        String   @id @default(cuid())
  depositId String   @unique
  userId    String
  amount    Float
  type      String // e.g. 'CRYPTO_DEPOSIT_BONUS' — kept as a plain string so a new promo type needs no migration
  status    String   @default("paid") // 'paid' | 'reversed' (if the underlying deposit is later refunded/reversed)
  createdAt DateTime @default(now())
  deposit   Deposit  @relation(fields: [depositId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Withdrawal {
  id                String           @id @default(cuid())
  userId            String
  amount            Float
  currency          String           @default("USD")
  paymentMethodId   String?
  accountInfo       String
  status            WithdrawalStatus @default(pending)
  adminNotes        String?
  processedBy       String?
  processedAt       DateTime?
  requestId         String?          @unique
  paymentMethodStr  String?
  accountDetails    String?
  approvedBy        String?
  approvedAt        DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?
  locked            Boolean          @default(false)
  telegramMessageId String?
  telegramChatId    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  paymentMethod     PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  user              User             @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId, status])
  @@index([requestId])
  @@index([createdAt])
}

model PaymentMethod {
  id             String            @id @default(cuid())
  name           String
  code           String            @unique
  type           PaymentMethodType
  isActive       Boolean           @default(true)
  minAmount      Float             @default(10)
  maxAmount      Float             @default(100000)
  feePercent     Float             @default(0)
  iconUrl        String?
  instructions   String?
  fields         Json              @default("[]")
  apiConfig      Json?
  cashoutEnabled Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deposits       Deposit[]
  withdrawals    Withdrawal[]
}

model Game {
  id            String         @id @default(cuid())
  name          String
  description   String
  category      String
  version       String
  downloadUrl   String?
  downloadCount Int            @default(0)
  isActive      Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  thumbnailUrl  String?
  screenshots   String[]       @default([])
  requirements  String?
  instructions  String?
  rating        Float          @default(0)
  providerId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  provider      Provider?      @relation(fields: [providerId], references: [id])
  downloads     GameDownload[]

  @@index([category])
  @@index([isFeatured])
}

model GameDownload {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, gameId])
}

model Bonus {
  id           String       @id @default(cuid())
  title        String
  description  String
  type         BonusType
  amount       Float?
  percentage   Float?
  minDeposit   Float?
  maxBonus     Float?
  requirements String
  terms        String
  expiresAt    DateTime?
  isActive     Boolean      @default(true)
  bannerUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  claims       BonusClaim[]
  wheelSpins   WheelSpin[]
}

model BonusClaim {
  id        String   @id @default(cuid())
  userId    String
  bonusId   String
  amount    Float
  createdAt DateTime @default(now())
  bonus     Bonus    @relation(fields: [bonusId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, bonusId])
  @@index([userId])
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  videoUrl  String?
  ctaText   String?
  ctaLink   String?
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, order])
}

model SupportTicket {
  id         String         @id @default(cuid())
  userId     String
  subject    String
  message    String
  status     TicketStatus   @default(open)
  priority   TicketPriority @default(medium)
  category   String
  assignedTo String?
  closedAt   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id])
  replies    TicketReply[]

  @@index([userId])
  @@index([status])
}

model TicketReply {
  id        String        @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(info)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model TransactionLog {
  id        String   @id @default(cuid())
  type      String
  entityId  String
  userId    String?
  amount    Float?
  status    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, entityId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  type      String    @default("info")
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model AdminWallet {
  id        String   @id @default(cuid())
  name      String
  type      String
  address   String
  currency  String
  isActive  Boolean  @default(true)
  totalIn   Float    @default(0)
  totalOut  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Provider {
  id             String                   @id @default(cuid())
  name           String
  apiBaseUrl     String
  agentId        String
  secretKey      String
  status         Boolean                  @default(true)
  logo           String?
  requestTimeout Int                      @default(5000)
  retryCount     Int                      @default(3)
  endpoints      Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  games          Game[]
  balanceHistory ProviderBalanceHistory[]
  logs           ProviderLog[]
  transactions   ProviderTransaction[]
  users          ProviderUser[]
}

model ProviderUser {
  id             String   @id @default(cuid())
  userId         String
  providerId     String
  providerUserId String
  accountName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'WALLET' | 'BONUS' | null — set on first recharge into an empty game balance, cleared on every full
  // cashout (which always sweeps to zero). Mixing sources into one still-active game balance is blocked
  // server-side, so this always reflects the single funding source of whatever is currently on the game.
  activeFundingSource         String?
  // Accumulates [{userBonusId, sourceType, amountConsumed}] across every BONUS-funded recharge in the
  // current session; reset on full cashout.
  activeSessionBonusBreakdown Json?

  @@unique([providerId, providerUserId])
  @@unique([userId, providerId])
  @@index([userId])
}

model ProviderLog {
  id           String    @id @default(cuid())
  providerId   String?
  userId       String?
  endpoint     String
  request      Json?
  response     Json?
  status       Int
  errorMessage String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  provider     Provider? @relation(fields: [providerId], references: [id])
}

// A per-grant balance instance for the new, genuinely separate Bonus Balance. Distinct from the existing
// `Bonus` (admin catalog/wheel prize definitions) and `BonusClaim` models, which are untouched and keep
// working exactly as they do today — this is a new, additive concept, not a replacement.
model UserBonus {
  id              String   @id @default(cuid())
  userId          String
  sourceType      String // 'CRYPTO_BONUS' | 'FREEPLAY' | 'REFERRAL_BONUS' | 'COUPON' | 'FREE_SPIN'
  originalAmount  Float
  remainingAmount Float // decrements as bonus-funded recharges consume it; sums to "Bonus Balance"
  status          String   @default("active") // 'active' | 'depleted' | 'reversed' | 'expired'
  referenceId     String? // id of the originating row (ReferralReward/CouponUsage/WheelSpin/DepositBonus/SundayFreeplayClaim) — traceability only
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  transactions    BonusTransaction[]

  @@index([userId, status, createdAt])
  @@index([sourceType])
}

model BonusTransaction {
  id            String   @id @default(cuid())
  userId        String
  userBonusId   String?
  type          String // BONUS_CREDIT | BONUS_GAME_DEBIT | BONUS_GAME_WIN | BONUS_CONVERSION | BONUS_EXPIRED | BONUS_REVERSAL
  sourceType    String?
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  referenceId   String?
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User       @relation(fields: [userId], references: [id])
  userBonus     UserBonus? @relation(fields: [userBonusId], references: [id])

  @@index([userId, createdAt])
  @@index([userBonusId])
  @@index([type])
}

model BonusCashoutRule {
  id                 String   @id @default(cuid())
  sourceTypes        String[] // empty array / contains 'ALL' = applies to every source type
  minAmount          Float
  maxAmount          Float
  walletCreditAmount Float
  priority           Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?
  conversions        BonusConversion[]

  @@index([isActive, priority])
}

// `providerTransactionOrderId` is the idempotency boundary — one conversion per cashout, ever. The rule*
// Snapshot fields capture the matched rule's numeric values AT THE TIME of conversion so that a later admin
// edit to the live BonusCashoutRule row can never retroactively change what a past conversion is shown to
// have applied.
model BonusConversion {
  id                         String   @id @default(cuid())
  userId                     String
  providerTransactionOrderId String   @unique
  totalWinnings              Float
  eligibleWalletCredit       Float
  ruleId                     String?
  ruleMinAmountSnapshot      Float?
  ruleMaxAmountSnapshot      Float?
  ruleWalletCreditSnapshot   Float?
  primarySourceType          String?
  sourceBreakdown            Json
  status                     String   @default("completed") // 'completed' | 'reversed'
  createdAt                  DateTime @default(now())
  user                       User              @relation(fields: [userId], references: [id])
  rule                       BonusCashoutRule? @relation(fields: [ruleId], references: [id])

  @@index([userId])
  @@index([ruleId])
}

// The [userId, weekKey] unique constraint IS the weekly cron's idempotency boundary — a re-run or
// crash-recovery simply hits a unique-constraint violation and moves on to the next user.
model SundayFreeplayClaim {
  id          String   @id @default(cuid())
  userId      String
  weekKey     String // UTC ISO week-year, e.g. "2026-W40"
  amount      Float    @default(3)
  userBonusId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, weekKey])
  @@index([userId])
}

// Audit trail for the WALLET side, mirroring BonusTransaction. Written best-effort alongside existing
// money-moving writes. NOT the source of truth for balance — WalletService's derived aggregate remains
// authoritative (rewriting every existing money-moving code path to a ledger-of-record model is out of
// scope for this feature).
model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  type          String // DEPOSIT | BONUS_CONVERSION | GAME_DEBIT | GAME_WIN | WITHDRAWAL_HOLD | WITHDRAWAL | WITHDRAWAL_REVERSAL | ADMIN_ADJUSTMENT
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  referenceId   String?
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type])
}

model ProviderTransaction {
  id              String   @id @default(cuid())
  providerId      String
  userId          String
  type            String
  amount          Float
  orderId         String   @unique
  providerOrderId String?
  // 'pending' (row created, provider not yet called or awaiting response) | 'success' | 'failed' (a
  // definitive provider rejection) | 'unknown' (an ambiguous/network-level failure — the provider may or may
  // not have processed it; needs reconciliation, never silently retried). orderId's uniqueness is what makes
  // a retry/duplicate request for the same logical transfer resolve to this same row instead of a new one.
  status          String
  errorMessage    String? // sanitized (no provider secrets/credentials) — set on 'failed'/'unknown'
  balanceBefore   Float? // live game balance snapshot taken right before the provider call, for reconciling
                          // a row stuck in 'unknown' later (an admin/reconciliation job compares it against
                          // the CURRENT live balance rather than needing to have caught it within the request)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  provider        Provider @relation(fields: [providerId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  // 'WALLET' | 'BONUS' — null for withdraws and pre-feature rows (treated as WALLET by WalletService's
  // `fundingSource: { not: 'BONUS' }` filter, never by an explicit 'WALLET' equality check).
  fundingSource        String?
  bonusSourceBreakdown Json?

  @@index([userId, type, status])
  @@index([providerId, userId, type, status])
  @@index([userId, providerId, type, status, createdAt(sort: Desc)])
}

model PaymentWebhook {
  id        String   @id @default(cuid())
  provider  String
  payload   Json
  status    String
  error     String?
  createdAt DateTime @default(now())
}

model DepositTransaction {
  id             String   @id @default(cuid())
  depositId      String   @unique
  providerId     String?
  transactionRef String   @unique
  status         String
  amount         Float
  currency       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deposit        Deposit  @relation(fields: [depositId], references: [id], onDelete: Cascade)
}

model ProviderBalanceHistory {
  id         String   @id @default(cuid())
  providerId String
  balance    Float
  recordedAt DateTime @default(now())
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                 String    @id @default(cuid())
  conversation_id    String    @unique
  user_id            String?
  telegram_user_id   String?
  telegram_username  String?
  telegram_thread_id String?
  source             String
  status             String    @default("open")
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  user               User?     @relation(fields: [user_id], references: [id])
  messages           Message[]

  @@index([conversation_id])
  @@index([telegram_thread_id])
}

model Message {
  id              String       @id @default(cuid())
  conversation_id String
  sender_type     String
  message         String
  created_at      DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
}

model Coupon {
  id         String        @id @default(cuid())
  code       String        @unique
  amount     Float         @default(3)
  isActive   Boolean       @default(true)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  usages     CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([couponId, userId])
}

enum Role {
  user
  admin
}

enum DepositStatus {
  pending
  processing
  approved
  failed
}

enum WithdrawalStatus {
  pending
  approved
  rejected
  paid
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum BonusType {
  welcome
  deposit
  referral
  vip
  seasonal
  wheel
  freeplay
}

enum PaymentMethodType {
  crypto
  card
  wallet
  bank
}

enum NotificationType {
  info
  success
  warning
  error
}
