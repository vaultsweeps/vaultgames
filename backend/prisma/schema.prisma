generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  user
  admin
}

enum DepositStatus {
  pending
  processing
  approved
  failed
}

enum WithdrawalStatus {
  pending
  approved
  rejected
  paid
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum BonusType {
  welcome
  deposit
  referral
  vip
  seasonal
}

enum PaymentMethodType {
  crypto
  card
  wallet
  bank
}

enum NotificationType {
  info
  success
  warning
  error
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  password    String
  role        Role     @default(user)
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  isBanned    Boolean  @default(false)
  verifyToken String?
  resetToken  String?
  resetExpiry DateTime?
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile       UserProfile?
  deposits      Deposit[]
  withdrawals   Withdrawal[]
  bonusClaims   BonusClaim[]
  gameDownloads GameDownload[]
  tickets       SupportTicket[]
  ticketReplies TicketReply[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  referrals     User[]         @relation("Referrals")
  referredBy    User?          @relation("Referrals", fields: [referredById], references: [id])
  referredById  String?

  @@index([email])
  @@index([username])
}

model UserProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  fullName         String?
  phone            String?
  country          String?
  avatar           String?
  telegramUsername String?
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deposit {
  id               String        @id @default(cuid())
  userId           String
  amount           Float
  currency         String        @default("USD")
  paymentMethodId  String?
  status           DepositStatus @default(pending)
  transactionId    String?
  paymentReference String?       @unique
  proofImage       String?
  notes            String?
  webhookData      Json?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([userId])
  @@index([status])
}

model Withdrawal {
  id               String           @id @default(cuid())
  userId           String
  amount           Float
  currency         String           @default("USD")
  paymentMethodId  String?
  accountInfo      String
  status           WithdrawalStatus @default(pending)
  adminNotes       String?
  processedBy      String?
  processedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([userId])
  @@index([status])
}

model PaymentMethod {
  id           String            @id @default(cuid())
  name         String
  code         String            @unique
  type         PaymentMethodType
  isActive     Boolean           @default(true)
  minAmount    Float             @default(10)
  maxAmount    Float             @default(100000)
  feePercent   Float             @default(0)
  iconUrl      String?
  instructions String?
  fields       Json              @default("[]")
  apiConfig    Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  deposits    Deposit[]
  withdrawals Withdrawal[]
}

model Game {
  id            String   @id @default(cuid())
  name          String
  description   String
  category      String
  version       String
  downloadUrl   String?
  downloadCount Int      @default(0)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  thumbnailUrl  String?
  screenshots   String[] @default([])
  requirements  String?
  instructions  String?
  rating        Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  downloads GameDownload[]

  @@index([category])
  @@index([isFeatured])
}

model GameDownload {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
}

model Bonus {
  id          String    @id @default(cuid())
  title       String
  description String
  type        BonusType
  amount      Float?
  percentage  Float?
  minDeposit  Float?
  maxBonus    Float?
  requirements String
  terms       String
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  bannerUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  claims BonusClaim[]
}

model BonusClaim {
  id        String   @id @default(cuid())
  userId    String
  bonusId   String
  amount    Float
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  bonus Bonus @relation(fields: [bonusId], references: [id])

  @@unique([userId, bonusId])
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  videoUrl  String?
  ctaText   String?
  ctaLink   String?
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, order])
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    TicketStatus   @default(open)
  priority  TicketPriority @default(medium)
  category  String
  assignedTo String?
  closedAt  DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  replies TicketReply[]

  @@index([userId])
  @@index([status])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(info)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model TransactionLog {
  id        String   @id @default(cuid())
  type      String
  entityId  String
  userId    String?
  amount    Float?
  status    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, entityId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  type      String    @default("info")
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model AdminWallet {
  id          String   @id @default(cuid())
  name        String
  type        String
  address     String
  currency    String
  isActive    Boolean  @default(true)
  totalIn     Float    @default(0)
  totalOut    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
